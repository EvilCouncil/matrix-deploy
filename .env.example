# Matrix homeserver identity (immutable once RocksDB database is initialized)
TUWUNEL_SERVER_NAME=matrix.evilcouncil.org

# Federation (disabled for private homelab server)
TUWUNEL_ALLOW_FEDERATION=false
TUWUNEL_TRUSTED_SERVERS=[]

# Account registration (keep false after bootstrapping @jubei, @hermes, @opencode)
# When true, Tuwunel requires a non-empty TUWUNEL_REGISTRATION_TOKEN (injected via Infisical/Portainer)
TUWUNEL_ALLOW_REGISTRATION=false
TUWUNEL_REGISTRATION_TOKEN=

# Request size limit in bytes (~20 MB) and log level
TUWUNEL_MAX_REQUEST_SIZE=20000000
TUWUNEL_LOG=info
